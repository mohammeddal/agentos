{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentOS",
  "version": "0.1.0",
  "identifier": "com.agentos.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:4173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "AgentOS", "width": 1440, "height": 920, "minWidth": 980, "minHeight": 680, "decorations": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "The operating environment for your AI workforce."
  }
}
